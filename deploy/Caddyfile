# clawd-computer reverse proxy
#
# Replace `clawd.computer` with your real domain. Caddy will auto-fetch
# a Let's Encrypt cert on first start (port 80 + 443 must be reachable).
#
# WebSockets are upgraded automatically by `reverse_proxy`.

clawd.computer {
    encode zstd gzip

    # Signaling WebSocket — strips the /ws prefix before forwarding.
    handle_path /ws* {
        reverse_proxy localhost:8080
    }

    # Next.js app
    reverse_proxy localhost:3000
}
